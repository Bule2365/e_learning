      <span class=sf-dump-str title=\"4516 characters\"> &#8722;b <span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4516 characters\">2<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4516 characters\">  (selisih kuadrat) dan <span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4516 characters\">&#119886;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4516 characters\">2<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
